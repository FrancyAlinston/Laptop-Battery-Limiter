[Desktop Entry]
Name=Universal Battery Limiter
Comment=Battery charge limit management for all compatible laptops
Exec=universal-battery-limiter.battery-gui
Icon=battery-limiter
Terminal=false
Type=Application
Categories=Settings;
Keywords=battery;charge;limit;laptop;power;management;
StartupNotify=true
X-GNOME-Autostart-enabled=false
X-Ubuntu-Gettext-Domain=universal-battery-limiter
